# ---------------------------------------------------------------------------
# FINB Platinum — project environment
#
# Copy to .env.local (`cp .env.example .env.local`) and fill in your own values.
# Every value is optional: without them the app still runs as a fully playable
# local build. The two Supabase values below are the live project credentials
# used by this deployment; both are publishable by design (they ship to the
# browser and are constrained by Row Level Security).
# ---------------------------------------------------------------------------

# Supabase (Auth, Database, Realtime, Storage). Apply supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=https://dwlkiislhsqmcregbmlq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_NiovXqO7quI0xaUYFXkS9g_GfIQrmBG
# Legacy alias, still accepted:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Colyseus authoritative multiplayer server (see server/index.ts).
# Set this to serve true 2–13 player rooms; without it the app seats practice rivals.
NEXT_PUBLIC_COLYSEUS_URL=

# Extra dev origins allowed to reach the Next.js dev server (comma separated).
FINB_DEV_ORIGINS=*.e2b.app,*.e2b.dev,localhost,127.0.0.1

# Colyseus server port + bind address (server/index.ts)
PORT=2567
HOST=0.0.0.0

# ---- scripts only: never expose these to the browser ----
# Service role key unlocks RLS; used exclusively by scripts/seed-supabase.mjs.
# SUPABASE_SERVICE_ROLE_KEY=
